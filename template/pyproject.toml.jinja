[build-system]
requires = ["hatchling>=1.24"]
build-backend = "hatchling.build"

[project]
name = "{{ project_slug }}"
version = "0.1.0"
description = "{{ project_description }}"
readme = "README.md"
requires-python = ">={{ python_version }}"
license = { text = "{{ license }}" }
authors = [
    { name = "{{ author_name }}", email = "{{ author_email }}" },
]
keywords = ["scraping", "crawler", "web", "fastapi", "cli"]
classifiers = [
    "Programming Language :: Python :: 3",
    "Programming Language :: Python :: {{ python_version }}",
    "Operating System :: OS Independent",
]

dependencies = [
    # HTTP + parsing
    "httpx>=0.27",
    "beautifulsoup4>=4.12",
    "lxml>=5.2",
    "markdownify>=0.13",
    "crawl4ai>=0.7",
    # Settings
    "pydantic>=2.7",
    "pydantic-settings>=2.3",
    "python-dotenv>=1.0",
    "PyYAML>=6.0",
    # Storage / ORM (drivers for SQLite + PostgreSQL/Supabase)
    "SQLAlchemy[asyncio]>=2.0",
    "aiosqlite>=0.20",
    "asyncpg>=0.29",
    "greenlet>=3.0",
    # Templating
    "Jinja2>=3.1",
    # UX
    "tqdm>=4.66",
    # Resilience
    "tenacity>=8.3",
{% if include_playwright %}
    # Browser automation
    "playwright>=1.45",
{% endif %}
{% if include_scrapy %}
    # Scrapy
    "scrapy>=2.11",
    "scrapy-playwright>=0.0.34",
{% endif %}
{% if include_cli %}
    # CLI
    "typer>=0.12",
    "rich>=13.7",
{% endif %}
{% if include_api %}
    # API + auth + UI templates
    "fastapi>=0.111",
    "uvicorn[standard]>=0.30",
    "fastapi-users[sqlalchemy]>=14.0",
    "python-multipart>=0.0.9",
    "itsdangerous>=2.2",
{% endif %}
    # Logging
    "structlog>=24.1",
]

[project.optional-dependencies]
dev = [
    "pytest>=8.2",
    "pytest-asyncio>=0.23",
    "pytest-cov>=5.0",
{% if include_api %}
    "httpx>=0.27",
{% endif %}
    "ruff>=0.5",
    "mypy>=1.10",
    "pre-commit>=3.7",
    "types-PyYAML>=6.0",
    "types-tqdm>=4.66",
    "types-beautifulsoup4>=4.12",
]

{% if include_cli %}

[project.scripts]
{{ project_slug }} = "{{ package_name }}.cli.main:app"
{% endif %}

[project.urls]
Homepage = "https://example.com/{{ project_slug }}"
Repository = "https://example.com/{{ project_slug }}"

[tool.hatch.build.targets.wheel]
packages = ["src/{{ package_name }}"]
{% if include_api %}

# Ship Jinja2 dashboard templates alongside the Python package.
[tool.hatch.build.targets.wheel.force-include]
"src/{{ package_name }}/api/templates" = "{{ package_name }}/api/templates"
{% endif %}

[tool.ruff]
line-length = 100
target-version = "py{{ python_version | replace('.', '') }}"

[tool.ruff.lint]
select = ["E", "F", "I", "B", "UP", "SIM", "RUF"]
ignore = ["E501"]

[tool.ruff.lint.flake8-bugbear]
# FastAPI relies on calling these in default args.
extend-immutable-calls = [
    "fastapi.Depends",
    "fastapi.Query",
    "fastapi.Header",
    "fastapi.Path",
    "fastapi.Body",
    "fastapi.Form",
    "fastapi.File",
]

[tool.mypy]
python_version = "{{ python_version }}"
strict = true
ignore_missing_imports = true

[tool.pytest.ini_options]
addopts = "-ra -q"
testpaths = ["tests"]
asyncio_mode = "auto"

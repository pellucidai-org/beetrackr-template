"""JSONL file backend (default).

One file per target at ``<output_dir>/<target>.jsonl``. Writes are buffered in
memory and flushed in :meth:`save` — call ``close()`` to release file handles.
"""

from __future__ import annotations

import json
from collections.abc import Iterable
from pathlib import Path
from typing import Any

from {{ package_name }}.logging import get_logger
from {{ package_name }}.settings import Settings
from {{ package_name }}.storage.base import ScrapedItem

log = get_logger("storage.jsonl")


class JSONLBackend:
    name = "jsonl"

    def __init__(self, settings: Settings) -> None:
        self._output_dir: Path = settings.storage.output_dir

    async def init(self) -> None:
        self._output_dir.mkdir(parents=True, exist_ok=True)

    async def close(self) -> None:  # pragma: no cover - nothing to do
        return None

    async def save(self, target: str, records: Iterable[dict[str, Any]]) -> int:
        out_path = self._output_dir / f"{target}.jsonl"
        out_path.parent.mkdir(parents=True, exist_ok=True)

        count = 0
        with out_path.open("a", encoding="utf-8") as fh:
            for record in records:
                item = ScrapedItem.from_record(target, record)
                fh.write(json.dumps(item.to_dict(), ensure_ascii=False) + "\n")
                count += 1

        log.info("jsonl.save", target=target, count=count, output=str(out_path))
        return count

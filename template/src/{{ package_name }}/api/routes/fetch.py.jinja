@router.get("/stats/timeline", response_model=list[TimelinePoint])
async def stats_timeline(
    session: Annotated[AsyncSession, Depends(get_async_session)],
    days: Annotated[int, Query(ge=1, le=365)] = 30,
) -> list[TimelinePoint]:
    """Records-per-day for the last ``days`` days."""
    day_col = cast(ScrapedItemORM.scraped_at, Date()).label("day")
    rows = (
        await session.execute(
            select(day_col, func.count(ScrapedItemORM.id))
            .group_by(day_col)
            .order_by(day_col.asc())
        )
    ).all()
    out = [TimelinePoint(date=str(day), count=int(c)) for day, c in rows]
    return out[-days:]


@router.get("/stats/complexity", response_model=list[HistogramBucket])
async def stats_complexity_histogram(
    session: Annotated[AsyncSession, Depends(get_async_session)],
    bins: Annotated[int, Query(ge=2, le=50)] = 10,
) -> list[HistogramBucket]:
    """Histogram of ``metadata.stats.page_complexity_score`` across rows.

    This is computed in Python after fetching the values because JSON path
    extraction is dialect-specific. For very large datasets, replace with a
    dialect-aware query.
    """
    rows = (
        await session.execute(
            select(ScrapedItemORM.metadata_).where(ScrapedItemORM.metadata_.is_not(None))
        )
    ).scalars().all()

    scores: list[float] = []
    for md in rows:
        if not isinstance(md, dict):
            continue
        stats = md.get("stats")
        if not isinstance(stats, dict):
            continue
        score = stats.get("page_complexity_score")
        if isinstance(score, (int, float)):
            scores.append(float(score))

    if not scores:
        return []

    lo, hi = min(scores), max(scores)
    if hi == lo:
        return [HistogramBucket(label=f"{lo:.1f}", lower=lo, upper=hi, count=len(scores))]

    width = (hi - lo) / bins
    buckets: list[HistogramBucket] = []
    for i in range(bins):
        lower = lo + i * width
        upper = lower + width if i < bins - 1 else hi + 1e-9
        count = sum(1 for s in scores if lower <= s < upper)
        buckets.append(
            HistogramBucket(
                label=f"{lower:.1f}-{upper:.1f}",
                lower=lower,
                upper=upper,
                count=count,
            )
        )
    return buckets

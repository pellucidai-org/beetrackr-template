@router.get("/artifacts", response_model=PaginatedArtifacts)
async def list_artifacts(
    session: Annotated[AsyncSession, Depends(get_async_session)],
    record_id: Annotated[str | None, Query()] = None,
    job_id: Annotated[str | None, Query()] = None,
    kind: Annotated[str | None, Query()] = None,
    target: Annotated[str | None, Query()] = None,
    limit: Annotated[int, Query(ge=1, le=500)] = 50,
    offset: Annotated[int, Query(ge=0)] = 0,
) -> PaginatedArtifacts:
    filters = []
    if record_id:
        filters.append(PageArtifactORM.record_id == record_id)
    if job_id:
        filters.append(PageArtifactORM.job_id == job_id)
    if kind:
        filters.append(PageArtifactORM.kind == kind)
    if target:
        filters.append(PageArtifactORM.target == target)

    count_stmt = select(func.count()).select_from(PageArtifactORM)
    stmt = select(PageArtifactORM).order_by(PageArtifactORM.created_at.desc())
    for f in filters:
        count_stmt = count_stmt.where(f)
        stmt = stmt.where(f)

    total = (await session.scalar(count_stmt)) or 0
    rows = (await session.execute(stmt.limit(limit).offset(offset))).scalars().all()

    return PaginatedArtifacts(
        total=total,
        limit=limit,
        offset=offset,
        items=[ArtifactRead.model_validate(r) for r in rows],
    )


@router.get("/artifacts/{artifact_id}", response_model=ArtifactRead)
async def get_artifact(
    artifact_id: int,
    session: Annotated[AsyncSession, Depends(get_async_session)],
) -> ArtifactRead:
    row = await session.get(PageArtifactORM, artifact_id)
    if row is None:
        raise HTTPException(status.HTTP_404_NOT_FOUND, "Artifact not found")
    return ArtifactRead.model_validate(row)


@router.get("/artifacts/{artifact_id}/file")
async def download_artifact(
    artifact_id: int,
    session: Annotated[AsyncSession, Depends(get_async_session)],
) -> FileResponse:
    """Stream the artifact bytes off disk."""
    row = await session.get(PageArtifactORM, artifact_id)
    if row is None:
        raise HTTPException(status.HTTP_404_NOT_FOUND, "Artifact not found")
    path = Path(row.path)
    if not path.exists() or not path.is_file():
        raise HTTPException(
            status.HTTP_410_GONE,
            f"Artifact file missing on disk: {path}",
        )
    return FileResponse(
        path=path,
        media_type=row.media_type or "application/octet-stream",
        filename=path.name,
    )



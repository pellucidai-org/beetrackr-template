"""Authenticated read API over ``scraped_items`` + ``page_artifacts``.

The fetch router is the canonical, type-safe surface to retrieve scraped
data. Every endpoint is protected by :func:`current_active_user` so the same
cookie / bearer token guards UI rendering and machine clients alike.

Endpoint groups
---------------
* ``/api/fetch/records`` — paginated record listing with ``target / job_id /
  scraper_key / status`` filters.
* ``/api/fetch/jobs`` — per-``job_id`` aggregates plus drill-down to the
  records belonging to one job.
* ``/api/fetch/artifacts`` — list / download artifact files registered via
  :class:`PageArtifactORM`.
* ``/api/fetch/stats/...`` — pre-aggregated distributions consumed by the UI
  ``/ui/distributions`` charts.
"""

from __future__ import annotations

from datetime import datetime
from pathlib import Path
from typing import Annotated, Any

from fastapi import APIRouter, Depends, HTTPException, Query, status
from fastapi.responses import FileResponse
from pydantic import BaseModel, ConfigDict, Field
from sqlalchemy import Date, cast, func, select
from sqlalchemy.ext.asyncio import AsyncSession

from {{ package_name }}.api.auth.users import current_active_user
from {{ package_name }}.api.database import get_async_session
from {{ package_name }}.storage.models import PageArtifactORM, ScrapedItemORM

router = APIRouter(
    prefix="/api/fetch",
    tags=["fetch"],
    dependencies=[Depends(current_active_user)],
)


# ---------------------------------------------------------------------------
# Pydantic response models
# ---------------------------------------------------------------------------


class RecordRead(BaseModel):
    """One row of ``scraped_items``."""

    id: int
    job_id: str
    record_id: str
    scraper_key: str
    target: str
    url: str
    status: int | None
    scraped_at: datetime
    data: dict[str, Any] = Field(default_factory=dict)
    metadata: dict[str, Any] = Field(default_factory=dict)


class PaginatedRecords(BaseModel):
    total: int
    limit: int
    offset: int
    items: list[RecordRead]


class JobSummary(BaseModel):
    job_id: str
    record_count: int
    targets: list[str]
    scraper_keys: list[str]
    started_at: datetime | None
    finished_at: datetime | None
    success_count: int = 0
    failure_count: int = 0


class JobDetail(JobSummary):
    artifact_count: int = 0
    artifacts_by_kind: dict[str, int] = Field(default_factory=dict)


class ArtifactRead(BaseModel):
    model_config = ConfigDict(from_attributes=True)

    id: int
    record_id: str
    job_id: str
    target: str
    kind: str
    path: str
    media_type: str
    size_bytes: int | None
    width: int | None
    height: int | None
    duration_ms: float | None
    extra: dict[str, Any] | None = None
    created_at: datetime


class PaginatedArtifacts(BaseModel):
    total: int
    limit: int
    offset: int
    items: list[ArtifactRead]


class StatsSummary(BaseModel):
    records: int
    jobs: int
    targets: int
    scrapers: int
    artifacts: int
    success_records: int
    failure_records: int


class CountByKey(BaseModel):
    key: str
    count: int


class CountByStatus(BaseModel):
    status: int | None
    count: int


class TimelinePoint(BaseModel):
    date: str
    count: int


class HistogramBucket(BaseModel):
    label: str
    lower: float
    upper: float
    count: int


# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------


def _row_to_record(row: ScrapedItemORM) -> RecordRead:
    return RecordRead(
        id=row.id,
        job_id=row.job_id,
        record_id=row.record_id,
        scraper_key=row.scraper_key,
        target=row.target,
        url=row.url,
        status=row.status,
        scraped_at=row.scraped_at,
        data=row.data or {},
        metadata=row.metadata_ or {},
    )


# ---------------------------------------------------------------------------
# Records
# ---------------------------------------------------------------------------


@router.get("/records", response_model=PaginatedRecords)
async def list_records(
    session: Annotated[AsyncSession, Depends(get_async_session)],
    target: Annotated[str | None, Query()] = None,
    job_id: Annotated[str | None, Query()] = None,
    scraper_key: Annotated[str | None, Query()] = None,
    status_code: Annotated[int | None, Query(alias="status")] = None,
    url_contains: Annotated[str | None, Query()] = None,
    limit: Annotated[int, Query(ge=1, le=500)] = 25,
    offset: Annotated[int, Query(ge=0)] = 0,
) -> PaginatedRecords:
    """List scraped records with filtering + pagination."""
    filters = []
    if target:
        filters.append(ScrapedItemORM.target == target)
    if job_id:
        filters.append(ScrapedItemORM.job_id == job_id)
    if scraper_key:
        filters.append(ScrapedItemORM.scraper_key == scraper_key)
    if status_code is not None:
        filters.append(ScrapedItemORM.status == status_code)
    if url_contains:
        filters.append(ScrapedItemORM.url.contains(url_contains))

    count_stmt = select(func.count()).select_from(ScrapedItemORM)
    stmt = select(ScrapedItemORM).order_by(ScrapedItemORM.scraped_at.desc())
    for f in filters:
        count_stmt = count_stmt.where(f)
        stmt = stmt.where(f)

    total = (await session.scalar(count_stmt)) or 0
    rows = (await session.execute(stmt.limit(limit).offset(offset))).scalars().all()

    return PaginatedRecords(
        total=total,
        limit=limit,
        offset=offset,
        items=[_row_to_record(r) for r in rows],
    )


@router.get("/records/{record_id}", response_model=RecordRead)
async def get_record(
    record_id: str,
    session: Annotated[AsyncSession, Depends(get_async_session)],
) -> RecordRead:
    row = (
        await session.execute(
            select(ScrapedItemORM).where(ScrapedItemORM.record_id == record_id)
        )
    ).scalar_one_or_none()
    if row is None:
        raise HTTPException(status.HTTP_404_NOT_FOUND, "Record not found")
    return _row_to_record(row)


# ---------------------------------------------------------------------------
# Jobs
# ---------------------------------------------------------------------------


async def _job_aggregates(
    session: AsyncSession,
    job_id: str | None = None,
    limit: int = 50,
    offset: int = 0,
) -> list[JobSummary]:
    """Return per-job aggregates, optionally filtered to ``job_id``."""
    stmt = (
        select(
            ScrapedItemORM.job_id.label("job_id"),
            func.count(ScrapedItemORM.id).label("record_count"),
            func.min(ScrapedItemORM.scraped_at).label("started_at"),
            func.max(ScrapedItemORM.scraped_at).label("finished_at"),
        )
        .group_by(ScrapedItemORM.job_id)
        .order_by(func.max(ScrapedItemORM.scraped_at).desc())
    )
    if job_id is not None:
        stmt = stmt.where(ScrapedItemORM.job_id == job_id)
    else:
        stmt = stmt.limit(limit).offset(offset)

    rows = (await session.execute(stmt)).all()

    out: list[JobSummary] = []
    for r in rows:
        targets = list(
            (
                await session.execute(
                    select(ScrapedItemORM.target)
                    .where(ScrapedItemORM.job_id == r.job_id)
                    .distinct()
                )
            )
            .scalars()
            .all()
        )
        scrapers = list(
            (
                await session.execute(
                    select(ScrapedItemORM.scraper_key)
                    .where(ScrapedItemORM.job_id == r.job_id)
                    .distinct()
                )
            )
            .scalars()
            .all()
        )
        success = (
            await session.scalar(
                select(func.count())
                .select_from(ScrapedItemORM)
                .where(ScrapedItemORM.job_id == r.job_id)
                .where(ScrapedItemORM.status.between(200, 399))
            )
        ) or 0
        failure = (
            await session.scalar(
                select(func.count())
                .select_from(ScrapedItemORM)
                .where(ScrapedItemORM.job_id == r.job_id)
                .where(
                    (ScrapedItemORM.status >= 400) | (ScrapedItemORM.status.is_(None))
                )
            )
        ) or 0

        out.append(
            JobSummary(
                job_id=r.job_id or "",
                record_count=int(r.record_count),
                targets=[t for t in targets if t],
                scraper_keys=[s for s in scrapers if s],
                started_at=r.started_at,
                finished_at=r.finished_at,
                success_count=int(success),
                failure_count=int(failure),
            )
        )
    return out


@router.get("/jobs", response_model=list[JobSummary])
async def list_jobs(
    session: Annotated[AsyncSession, Depends(get_async_session)],
    limit: Annotated[int, Query(ge=1, le=500)] = 50,
    offset: Annotated[int, Query(ge=0)] = 0,
) -> list[JobSummary]:
    return await _job_aggregates(session, limit=limit, offset=offset)


@router.get("/jobs/{job_id}", response_model=JobDetail)
async def get_job(
    job_id: str,
    session: Annotated[AsyncSession, Depends(get_async_session)],
) -> JobDetail:
    summaries = await _job_aggregates(session, job_id=job_id)
    if not summaries:
        raise HTTPException(status.HTTP_404_NOT_FOUND, "Job not found")
    summary = summaries[0]

    art_total = (
        await session.scalar(
            select(func.count())
            .select_from(PageArtifactORM)
            .where(PageArtifactORM.job_id == job_id)
        )
    ) or 0
    by_kind_rows = (
        await session.execute(
            select(PageArtifactORM.kind, func.count(PageArtifactORM.id))
            .where(PageArtifactORM.job_id == job_id)
            .group_by(PageArtifactORM.kind)
        )
    ).all()
    by_kind = {k: int(c) for k, c in by_kind_rows}

    return JobDetail(
        **summary.model_dump(),
        artifact_count=int(art_total),
        artifacts_by_kind=by_kind,
    )


@router.get("/jobs/{job_id}/records", response_model=PaginatedRecords)
async def list_job_records(
    job_id: str,
    session: Annotated[AsyncSession, Depends(get_async_session)],
    limit: Annotated[int, Query(ge=1, le=500)] = 100,
    offset: Annotated[int, Query(ge=0)] = 0,
) -> PaginatedRecords:
    total = (
        await session.scalar(
            select(func.count())
            .select_from(ScrapedItemORM)
            .where(ScrapedItemORM.job_id == job_id)
        )
    ) or 0
    rows = (
        await session.execute(
            select(ScrapedItemORM)
            .where(ScrapedItemORM.job_id == job_id)
            .order_by(ScrapedItemORM.scraped_at.desc())
            .limit(limit)
            .offset(offset)
        )
    ).scalars().all()
    return PaginatedRecords(
        total=total,
        limit=limit,
        offset=offset,
        items=[_row_to_record(r) for r in rows],
    )



"""Tests for artifact path helpers."""

from __future__ import annotations

from pathlib import Path

from {{ package_name }}.scrapers._artifacts import artifact_path, url_slug


def test_slug_is_deterministic() -> None:
    a = url_slug("https://example.com/foo/bar?q=1")
    b = url_slug("https://example.com/foo/bar?q=1")
    assert a == b


def test_distinct_urls_distinct_slugs() -> None:
    assert url_slug("https://example.com/a") != url_slug("https://example.com/b")


def test_slug_is_filesystem_safe() -> None:
    bad = url_slug("https://example.com/some path/!@#$%^&*()=+[]{};:'\"<>?,./|\\")
    assert "/" not in bad
    assert " " not in bad
    assert all(c.isalnum() or c in "._-" for c in bad)


def test_artifact_path_creates_parents(tmp_path: Path) -> None:
    out = artifact_path(tmp_path / "html", "example", "https://example.com/", ".html")
    assert out.parent.is_dir()
    assert out.suffix == ".html"
    assert "example" in str(out)

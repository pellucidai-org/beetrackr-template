# =============================================================================
# Airalo Scraper - environment variables
# =============================================================================
# Copy this file to `.env` and adjust values. NEVER commit secrets.
#
# Variables map onto the `Settings` pydantic-settings model.
# Nested keys use the delimiter `__` (e.g. SCRAPER__USER_AGENT).
# =============================================================================

# ---- Core ----
APP_NAME="Airalo Scraper"
ENVIRONMENT=development           # development | staging | production
DEBUG=true
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR
CONFIG_FILE=config.yaml           # path to scraper config (yaml or json)

# ---- Scraper defaults (override values from config.yaml) ----
SCRAPER__USER_AGENT="Airalo Scraper/0.1 (+https://example.com)"
SCRAPER__REQUEST_TIMEOUT=30
SCRAPER__MAX_RETRIES=3
SCRAPER__CONCURRENCY=8
SCRAPER__PROXY=
SCRAPER__SAVE_RAW_HTML=false
SCRAPER__RAW_HTML_DIR=./data/html
SCRAPER__SAVE_MARKDOWN=false
SCRAPER__MARKDOWN_DIR=./data/markdown

# ---- Playwright ----
PLAYWRIGHT__HEADLESS=true
PLAYWRIGHT__BROWSER=chromium          # chromium | firefox | webkit
PLAYWRIGHT__NAVIGATION_TIMEOUT_MS=30000
PLAYWRIGHT__LAUNCH_MAX_RETRIES=3
PLAYWRIGHT__LAUNCH_RETRY_BACKOFF=2.0
PLAYWRIGHT__RECORD_VIDEO=false
PLAYWRIGHT__RECORD_VIDEO_DIR=./data/videos
PLAYWRIGHT__SCREENSHOT=false
PLAYWRIGHT__SCREENSHOT_DIR=./data/screenshots
PLAYWRIGHT__SCREENSHOT_FULL_PAGE=true
PLAYWRIGHT__SCREENSHOT_FORMAT=png     # png | jpeg

# ---- API ----
API__HOST=0.0.0.0
API__PORT=8000
API__RELOAD=true
API__API_KEY=change-me                       # legacy header key for /scrape

# Auth (fastapi-users). Generate a fresh secret with `openssl rand -hex 32`.
API__JWT_SECRET=change-me-in-production
API__JWT_LIFETIME_SECONDS=3600
API__COOKIE_NAME=airalo_auth
API__COOKIE_SECURE=false                     # true behind HTTPS in prod
API__COOKIE_SAMESITE=lax                     # lax | strict | none
API__ALLOW_REGISTRATION=true
API__VERIFY_USERS=false

# Where the API reads scraped data from. Leave blank to reuse STORAGE__DATABASE_URL.
# API__DATABASE_URL=

# UI dashboard
API__ENABLE_UI=true
API__UI_PAGE_SIZE=25

# ---- Storage ----
STORAGE__BACKEND=jsonl                                   # jsonl | sql | mongo | kafka
STORAGE__OUTPUT_DIR=./data

# SQL backend (used when STORAGE__BACKEND=sql)
STORAGE__DATABASE_URL=sqlite+aiosqlite:///./data/scraper.db
# STORAGE__DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/scraper
# STORAGE__DATABASE_URL=postgresql+asyncpg://postgres:PASS@db.<ref>.supabase.co:5432/postgres
STORAGE__SQL_ECHO=false
STORAGE__SQL_POOL_SIZE=5
STORAGE__SQL_CREATE_TABLES=true

# ---- Secrets / third-party (examples) ----
# SENTRY_DSN=
# REDIS_URL=redis://localhost:6379/0

# Version control
.git
.gitignore
.gitattributes

# Editor / OS
.DS_Store
.idea
.vscode

# Python build artifacts
__pycache__
*.py[cod]
*$py.class
*.egg-info
.eggs
build/
dist/
.pytest_cache
.ruff_cache
.mypy_cache
.coverage
htmlcov
coverage.xml

# Virtual envs
.venv
venv
env

# Runtime data + secrets (mount these at runtime instead)
data/
*.db
*.sqlite
.env
.env.*
!.env.template

# Artifacts that should not bloat the build context
*.log
*.webm
*.mp4
*.har
screenshots/
videos/
raw_html/

# Tests / docs are not needed at runtime
tests/
docs/
*.md
!README.md
